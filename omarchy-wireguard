#!/usr/bin/env bash
# WireGuard helper for the io.github.codemonkey76.wireguard Omarchy widget.
#
#   omarchy-wireguard [json]                     every tunnel's state, as JSON
#   omarchy-wireguard up|down|restart NAME       drive a wg-quick tunnel
#   omarchy-wireguard enable|disable NAME        start it at boot, or stop doing so
#   omarchy-wireguard probe HOST [NAME]          interface-bound latency (JSON)
#   omarchy-wireguard notify NAME STATE SUMMARY [BODY]
#                                                desktop notification, sent once
#                                                per tunnel+state within 30s
#
# This script runs as you. Everything that needs root goes through the root
# helper (omarchy-wireguard-root, installed by install-helper) in a single
# `sudo -n` call, so it never prompts. Without the root helper the widget
# still shows which interfaces are up, their addresses, traffic and DNS, just
# not configs, peers, handshakes or the switches.

set -uo pipefail
export LC_ALL=C

ROOT_HELPER=/usr/local/libexec/omarchy-wireguard/omarchy-wireguard-root
BUNDLED_ROOT_HELPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/omarchy-wireguard-root"
RUNTIME="${BUNDLED_ROOT_HELPER%/*}/runtime.py"

# Shared between every copy of the widget (there is one per monitor): when a
# tunnel was last driven from here, and which notifications went out recently.
STATE_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/omarchy-wireguard"

die() { jq -cn --arg e "$*" '{ok: false, error: $e}'; exit 1; }

valid_name() { [[ $1 =~ ^[A-Za-z0-9_=+][A-Za-z0-9_=+.-]{0,14}$ ]]; }

# Bound both the producer's lifetime and the amount retained by QML/Bash.
capture() {
  local seconds=$1 output rc; shift
  output=$(timeout -k 2 "$seconds" "$@" 2>&1 | head -c 131073); rc=$?
  (( ${#output} <= 131072 )) || return 125
  (( rc == 0 )) || { printf '%s' "$output"; return "$rc"; }
  printf '%s' "$output"
}

state() { python3 "$RUNTIME" "$@"; }

in_list() {  # in_list NEEDLE ITEMS...
  local needle=$1; shift
  local item
  for item in "$@"; do [[ $item == "$needle" ]] && return 0; done
  return 1
}

# Demo mode, for screenshots: `touch "$XDG_RUNTIME_DIR/omarchy-wireguard/demo"`
# and the widget shows made-up tunnels instead of yours. Remove it to go back.
demo() {
  local flag
  flag=$(state demo) || die "unsafe or unavailable runtime state: $flag"
  [[ $flag == true ]]
}

expected_version() { sed -n 's/^VERSION=//p' "$BUNDLED_ROOT_HELPER" 2>/dev/null | head -n 1; }

# iproute2 7.2 emits an empty {} for every link the type filter skips, so
# drop entries without a name rather than reading them as "null".
live_links() {
  local links
  links=$(capture 3 ip -j link show type wireguard) || return 1
  jq -ce 'if type == "array" then map(select(.ifname != null)) else error("invalid links") end' <<<"$links"
}

# resolvectl prints "Link 70 (wg0): 10.8.0.53 10.8.0.54" -> ["10.8.0.53","10.8.0.54"]
resolved_list() {
  local output
  output=$(capture 2 resolvectl "$1" "$2") || { printf '[]'; return; }
  printf '%s' "$output" | sed 's/^[^:]*:[[:space:]]*//' |
    jq -Rsc 'split("\n") | map(split(" ")) | add // [] | map(select(. != ""))'
}

# What anyone can see about a live interface, plus the port and peers the root
# helper reported for it (null without the helper).
live_json() {  # live_json NAME PRIV_LIVE_ENTRY
  local name=$1 priv=$2 rx tx addrs mtu dns domains link up ifindex
  valid_name "$name" || return 1
  rx=$(cat "/sys/class/net/$name/statistics/rx_bytes" 2>/dev/null); [[ $rx =~ ^[0-9]+$ ]] || return 1
  tx=$(cat "/sys/class/net/$name/statistics/tx_bytes" 2>/dev/null); [[ $tx =~ ^[0-9]+$ ]] || return 1
  addrs=$(capture 3 ip -j addr show dev "$name") || return 1
  addrs=$(jq -ce 'if length == 1 then [.[0].addr_info[]? | "\(.local)/\(.prefixlen)"] else error("missing interface") end' <<<"$addrs") || return 1
  link=$(capture 3 ip -j link show dev "$name") || return 1
  jq -e 'length == 1 and (.[0].flags | type) == "array" and (.[0].ifindex | type) == "number"' <<<"$link" >/dev/null || return 1
  mtu=$(jq '.[0].mtu // null' <<<"$link")
  ifindex=$(jq '.[0].ifindex' <<<"$link")
  up=$(jq '.[0].flags | index("UP") != null' <<<"$link")
  dns=$(resolved_list dns "$name")
  domains=$(resolved_list domain "$name")
  jq -cn --argjson rx "$rx" --argjson tx "$tx" --argjson addrs "${addrs:-[]}" \
    --argjson mtu "${mtu:-null}" --argjson dns "${dns:-[]}" --argjson domains "${domains:-[]}" \
    --argjson priv "${priv:-null}" --argjson up "$up" --argjson ifindex "$ifindex" '
    {up: $up, ifindex: $ifindex, rx: $rx, tx: $tx, addresses: $addrs, mtu: $mtu, dns: $dns, domains: $domains,
     listenPort: ($priv.listenPort // null),
     peers: (if $priv == null then null else $priv.peers end)}'
}

status_json() {
  demo && { demo_json; return; }

  local priv root=false installed=false confs lives name conf live driven links helper_error="" objs=()
  [[ -x $ROOT_HELPER ]] && installed=true
  if priv=$(capture 12 sudo -n "$ROOT_HELPER" status) && jq -e '.version and (.configs | type == "object") and (.live | type == "object")' <<<"$priv" >/dev/null 2>&1; then
    root=true
  else
    if $installed; then helper_error=$(printf '%s' "$priv" | tail -n 1 | head -c 300); fi
    priv='{"version": null, "configs": {}, "live": {}}'
  fi

  links=$(live_links) || die "could not read WireGuard interface inventory"
  mapfile -t confs < <(jq -r '.configs | keys[]' <<<"$priv")
  mapfile -t lives < <(jq -r '.[].ifname' <<<"$links")

  while read -r name; do
    [[ -n $name ]] && valid_name "$name" || continue
    conf=$(jq -c --arg n "$name" '.configs[$n] // null' <<<"$priv")
    live=null
    if in_list "$name" "${lives[@]}"; then
      live=$(live_json "$name" "$(jq -c --arg n "$name" '.live[$n] // null' <<<"$priv")") || die "could not read interface $name"
    fi
    driven=$(state driven "$name") || die "unsafe runtime marker for $name"
    objs+=("$(jq -cn --arg name "$name" --argjson conf "${conf:-null}" --argjson live "${live:-null}" \
      --argjson driven "$driven" '
      {name: $name, configured: ($conf != null), up: ($live.up // false), drivenAt: $driven, config: $conf}
      + ($live // {rx: 0, tx: 0, addresses: [], mtu: null, dns: [], domains: [], listenPort: null, peers: null})
      # The kernel only knows the resolved endpoint IP; carry the configured
      # hostname across so the panel can show vpn.example.com rather than an IP.
      | if (.peers | type) == "array" and $conf != null then
          .peers |= map(. as $p | . + {endpointHost:
            ([$conf.peers[] | select(.publicKey == $p.publicKey) | .endpoint][0] // null)})
        else . end')")
  done < <(printf '%s\n' "${confs[@]}" "${lives[@]}" | sort -u)

  printf '%s\n' "${objs[@]}" |
    jq -cs --argjson now "$(date +%s)" --argjson root "$root" --argjson installed "$installed" \
      --arg version "$(jq -r '.version // empty' <<<"$priv")" --arg expected "$(expected_version)" --arg helperError "$helper_error" '
      {ok: true, demo: false, now: $now, privileged: $root,
       helper: {installed: $installed,
                error: $helperError,
                version: (if $version == "" then null else $version end),
                expected: (if $expected == "" then null else $expected end)},
       tunnels: .}'
}

# Made-up tunnels for screenshots. Counters are integrals of wandering,
# always-positive rates, so the graph moves like real traffic and the counters
# only ever grow (they wrap every two hours, which the widget treats as a
# restarted interface).
demo_json() {
  local now t rx tx
  now=$(date +%s)
  t=$(date +%s.%N)
  read -r rx tx < <(awk -v t="$t" 'BEGIN {
    t = t % 7200
    rx = 1400000 * t - 6300000 * cos(t / 7) + 805000 * sin(t / 2.3) + 6300000
    tx = 200000 * t - 600000 * cos(t / 5) + 102000 * sin(t / 1.7) + 600000
    printf "%.0f %.0f\n", rx, tx }')
  jq -cn --argjson now "$now" --argjson rx "$rx" --argjson tx "$tx" --argjson hs "$((now - 3 - now % 41))" '
    ["10.8.0.0/24", "192.168.50.0/24", "172.20.0.0/16"] as $officeRoutes
    | "Hq8vN3kR2mXw7LpT9sYc4bJ6fA1dG5eZ0uV8iO3nQ2c=" as $officeKey
    | "pX5wM2qL8rT1yK7vB4nC9dF6gH3jS0aE2uI5oZ8lW4k=" as $homeKey
    | {ok: true, demo: true, now: $now, privileged: true,
       helper: {installed: true, version: "demo", expected: "demo"},
       tunnels: [
         {name: "office", configured: true, up: true, drivenAt: null,
          config: {addresses: ["10.8.0.2/24"], dns: ["10.8.0.1"], autostart: true,
                   peers: [{publicKey: $officeKey, endpoint: "vpn.example.com:51820", allowedIps: $officeRoutes, keepalive: 25}]},
          rx: $rx, tx: $tx, addresses: ["10.8.0.2/24"], mtu: 1420, dns: ["10.8.0.1"], domains: ["~corp.example.com"],
          listenPort: 51820,
          peers: [{publicKey: $officeKey, endpoint: "203.0.113.10:51820", allowedIps: $officeRoutes,
                   handshake: $hs, rx: $rx, tx: $tx, keepalive: 25, endpointHost: "vpn.example.com:51820"}]},
         {name: "home", configured: true, up: false, drivenAt: null,
          config: {addresses: ["10.9.0.5/32"], dns: [], autostart: false,
                   peers: [{publicKey: $homeKey, endpoint: "home.example.net:51820", allowedIps: ["192.168.1.0/24"], keepalive: 25}]},
          rx: 0, tx: 0, addresses: [], mtu: null, dns: [], domains: [], listenPort: null, peers: null}
       ]}'
}

# Marks the tunnel as changed on purpose, so no widget copy announces it.
mark_driven() { state mark "$1" >/dev/null || die "unsafe runtime state; refusing action"; }

require_helper() {
  local have
  have=$(capture 3 sudo -n "$ROOT_HELPER" version) || die "the root helper isn't available; run install-helper"
  [[ $have == "$(expected_version)" ]] || die "the root helper is out of date; run install-helper"
}

drive() {  # drive up|down|restart NAME
  local verb=$1 name=${2:-} log rc reached=false complaint observed
  demo && die "demo mode is on (remove $STATE_DIR/demo)"
  valid_name "$name" || die "invalid tunnel name: '$name'"
  require_helper

  mark_driven "$name"
  case $verb in
    up|down) log=$(capture 125 sudo -n "$ROOT_HELPER" "$verb" "$name"); rc=$? ;;
    restart)
      log=$(capture 125 sudo -n "$ROOT_HELPER" down "$name"); rc=$?
      [[ $log == omarchy-wireguard-root:* ]] && die "$log"
      (( rc != 124 && rc != 125 && rc != 137 && rc != 141 )) || die "restart interrupted; inspect tunnel state"
      local remaining
      remaining=$(live_links) || die "could not verify tunnel stopped"
      jq -e --arg n "$name" 'any(.[]; .ifname == $n)' <<<"$remaining" >/dev/null && die "tunnel did not stop; restart aborted"
      log=$(capture 125 sudo -n "$ROOT_HELPER" up "$name"); rc=$?
      ;;
  esac
  # Again on completion: the quiet window runs from when the change landed,
  # not from when it was asked for.
  mark_driven "$name"
  (( rc != 124 && rc != 125 && rc != 137 && rc != 141 )) || die "operation interrupted; inspect tunnel state"

  # wg-quick echoes every step as "[#] ..." on stderr; the useful line is the
  # last one that is not a trace.
  complaint=$(grep -v '^\[#\]' <<<"$log" | tail -n 1 | head -c 512)

  # The root helper refusing the request (bad name, no such config) is always
  # a failure, whatever state the interface happens to be in.
  [[ $complaint == omarchy-wireguard-root:* ]] && die "${complaint#omarchy-wireguard-root: }"

  # wg-quick exits non-zero when a hook fails even if the tunnel went where it
  # was asked — e.g. `PostDown = resolvectl revert %i`, which runs after the
  # interface is already deleted. Judge by the end state and pass the
  # complaint on as a warning. (A failed PostUp makes wg-quick tear the
  # interface down again, so that still reads as a failure.)
  observed=$(live_links) || die "could not verify the final tunnel state"
  if [[ $verb == down ]]; then
    jq -e --arg n "$name" 'any(.[]; .ifname == $n)' <<<"$observed" >/dev/null || reached=true
  else
    jq -e --arg n "$name" 'any(.[]; .ifname == $n and (.flags | index("UP") != null))' <<<"$observed" >/dev/null && reached=true
  fi

  if ((rc == 0)); then jq -cn '{ok: true}'
  elif $reached; then jq -cn --arg w "$complaint" '{ok: true, warning: $w}'
  else die "$complaint"; fi
}

# Enables or disables wg-quick@NAME.service. Only the next boot changes; the
# tunnel stays up or down as it is now.
set_autostart() {  # set_autostart enable|disable NAME
  local verb=$1 name=${2:-} have log
  demo && die "demo mode is on (remove $STATE_DIR/demo)"
  valid_name "$name" || die "invalid tunnel name: '$name'"
  require_helper

  if log=$(capture 35 sudo -n "$ROOT_HELPER" "$verb" "$name"); then jq -cn '{ok: true}'
  else die "$(tail -n 1 <<<"$log" | sed 's/^omarchy-wireguard-root: //')"; fi
}

probe() {
  local host=${1:-} interface=${2:-} ms links
  [[ $host =~ ^[A-Za-z0-9.:-]{1,253}$ ]] || die "invalid host: '$host'"
  if demo; then
    ms=$((12 + $(date +%s) % 7))
  else
    if [[ -z $interface ]]; then
      links=$(live_links) || die "could not read WireGuard interfaces"
      interface=$(jq -er '[.[] | select(.flags | index("UP") != null)] | if length == 1 then .[0].ifname else error("specify a tunnel") end' <<<"$links") || die "specify an interface when zero or several tunnels are up"
    fi
    valid_name "$interface" || die "invalid interface name"
    exec timeout -k 1 15 python3 "$RUNTIME" probe "$interface" "$host"
  fi
  jq -cn --arg host "$host" --arg ms "$ms" \
    '{host: $host, ms: (if $ms == "" then null else ($ms | tonumber) end)}'
}

# Every monitor runs its own copy of the widget, and each notices the same
# change within a poll or two. The first to get here sends it; the rest find a
# fresh marker for that tunnel+state and stay quiet.
notify_once() {  # notify_once NAME STATE SUMMARY [BODY]
  local name=${1:-} state=${2:-} summary=${3:-} body=${4:-}
  valid_name "$name" || die "invalid tunnel name: '$name'"
  [[ $state =~ ^[a-z]{1,20}$ ]] || die "invalid state: '$state'"
  demo && return 0
  state notify "$name" "$state" "$summary" "$body"
}

case ${1:-json} in
  json) status_json ;;
  up|down|restart) drive "$1" "${2:-}" ;;
  enable|disable) set_autostart "$1" "${2:-}" ;;
  probe) probe "${2:-}" "${3:-}" ;;
  notify) shift; notify_once "$@" ;;
  *) echo "usage: omarchy-wireguard [json | up|down|restart NAME | enable|disable NAME | probe HOST [NAME] | notify NAME STATE SUMMARY [BODY]]" >&2; exit 2 ;;
esac
